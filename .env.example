# MULTIA funciona por defecto con IA Web sin clave.
VITE_USE_PROXY=true

# Generación segmentada. No son valores ilimitados; se ajustan a rangos seguros.
VITE_WEBLLM_SEGMENT_TOKENS=1536
VITE_WEBLLM_MAX_CONTINUATIONS=8
VITE_EXTERNAL_MAX_OUTPUT_TOKENS=8192

# Proveedores externos OPCIONALES. En OpenShift use un Secret.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Ollama es opcional y exige un servidor accesible desde el Pod.
OLLAMA_BASE_URL=

PORT=3000
HOST=0.0.0.0
PROXY_REQUESTS_PER_MINUTE=30
BUILDER_REQUESTS_PER_MINUTE=12
DOWNLOAD_TICKET_TTL_MS=1800000
WORKSPACE_ROOT=/tmp/multia-workspaces
WORKSPACE_TTL_MINUTES=120
WORKSPACE_MAX_FILES=300
WORKSPACE_MAX_FILE_BYTES=1500000
WORKSPACE_MAX_BYTES=25000000

# Análisis de ubicación por GPS/EXIF. Solo se envían coordenadas al geocodificador; nunca la fotografía.
LOCATION_REQUESTS_PER_MINUTE=10
NOMINATIM_USER_AGENT=MULTIA/4.0 robust-location-context

# Auditoría preventiva de sitios autorizados. Lista fija de puertos; sin explotación.
WEBSITE_AUDIT_REQUESTS_PER_MINUTE=3
WEBSITE_AUDIT_REQUESTS_PER_DAY=20

# Centro de operaciones seguras: solo archivos autorizados; no ejecuta comandos.
SECURITY_ARTIFACT_REQUESTS_PER_MINUTE=5
SECURITY_ARTIFACT_REQUESTS_PER_DAY=30

# MULTIA 4.0: autenticación y persistencia
AUTH_REQUIRED=true
SESSION_TTL_HOURS=12
MULTIA_DB_PATH=/tmp/multia-data/multia.db
# Opcional para crear el primer administrador sin token en logs:
MULTIA_ADMIN_USERNAME=
MULTIA_ADMIN_DISPLAY_NAME=
MULTIA_ADMIN_PASSWORD=
MULTIA_BOOTSTRAP_TOKEN=
